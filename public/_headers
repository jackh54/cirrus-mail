# Static assets only (Worker responses under /api/* set their own headers).
# Vite's content-hashed bundles never change at a given URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Entry points must always revalidate so a deploy is picked up immediately.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
