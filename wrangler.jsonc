{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cirrus-mail",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // The SPA is served from static assets. Only /api/* and the CardDAV/CalDAV paths run the Worker first.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/dav", "/dav/*", "/.well-known/caldav", "/.well-known/carddav"]
  },

  // Run the Worker near D1 (ENAM): /api requests make several D1 round trips, assets still come from the edge.
  "placement": { "mode": "smart" },

  // D1 and R2 are provisioned automatically on first deploy (no IDs needed).
  "d1_databases": [
    { "binding": "DB", "database_name": "cirrus-mail", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "cirrus-mail" }
  ],

  // Outbound mail through Cloudflare Email Service. Local `npm run dev` simulates sends;
  // set "remote": true here only if you want real delivery while developing.
  "send_email": [
    { "name": "EMAIL" }
  ],

  // Scheduled sends + hourly cleanup.
  "triggers": { "crons": ["* * * * *"] },

  "vars": {
    "APP_NAME": "Cirrus Mail"
  },

  // Privacy: no per-request invocation logs (they contain client IPs).
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "preview_urls": false,
  "upload_source_maps": true
}
